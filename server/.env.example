# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (dashboard URL)
CORS_ORIGINS=http://localhost:5173
# Public address of the app — used for seller portal links in emails (leave empty to use the request's origin)
PUBLIC_APP_URL=
# Brand name shown on the public "Sell your house" site and seller portal
COMPANY_NAME=PropBot Home Buyers

# ─── Database (MongoDB) ───────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/propbot
# Cloud:  MongoDB Atlas free M0 cluster connection string
MONGODB_URI=mongodb://127.0.0.1:27017/propbot

# ─── Auth ─────────────────────────────────────────────────
# Long random string used to sign dashboard login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# First admin account (created automatically on first boot if no users exist)
ADMIN_EMAIL=admin@propbot.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Acquisition Admin

# Key that external listing sources send in the "x-api-key" header to POST /api/leads/webhook
WEBHOOK_API_KEY=change-me-webhook-key
# Key Cloud Scheduler sends in the "x-cron-secret" header to /api/jobs/*
CRON_SECRET=change-me-cron-secret

# ─── Google Gemini (Google AI Studio free tier) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# ─── OpenStreetMap Nominatim ──────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim usage policy requires an identifying User-Agent with contact info
NOMINATIM_USER_AGENT=PropBot/1.0 (contact: ops@your-company.com)
NOMINATIM_TIMEOUT_MS=4000

# ─── SendGrid ─────────────────────────────────────────────
SENDGRID_API_KEY=
# Must be a verified sender in your SendGrid account
SENDGRID_FROM_EMAIL=acquisitions@your-company.com
SENDGRID_FROM_NAME=PropBot Acquisitions
# Recipient(s) of the daily digest (comma-separated)
DIGEST_RECIPIENTS=

# ─── Underwriting rules ───────────────────────────────────
# Leads scoring at or above this go straight to "Offer Drafted"
VIABILITY_THRESHOLD=70
# A hot lead untouched for this many hours is flagged stale by the audit job
STALE_LEAD_HOURS=48
# When true, leads in "Offer Drafted" auto-advance to "Awaiting Approval"
AUTO_QUEUE_FOR_APPROVAL=false
